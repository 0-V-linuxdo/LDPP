{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "no-unused-vars": "error",
        "no-console": "off",
        "eqeqeq": ["error", "always", { "null": "ignore" }],
        "no-underscore-dangle": ["warn", { "allow": ["__container__"] }]
    },
    "ignorePatterns": ["userscript/**", "dist/**", "node_modules/**"]
}
